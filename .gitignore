# See scripts/setup-references.sh to initialize them

# Temporary files
tmp/
# NFS "silly-rename" artifacts (deleted-but-open files)
.nfs*

.claude/worktrees/
tests/decompiler_fixtures/build/

# The S5 equivalence scorecard's labelled mutant corpus, regenerated with
# `uv run python tools/equiv_mutants.py`. Generated, never edited.
tests/csource_equiv/

# execution-differential scratch (GLAURUNG_FIXTURE_TMPDIR)
.exectmp/
tests/realistic_corpus/build/

# defect-reproduction scratch: disposable by construction — every source is
# embedded in docs/design/decbench-defect-reproductions-2026-08-27.md
.scratch/

# Third-party reference checkouts fetched by scripts/fetch-reference.sh
# (reference/specifications/ IS tracked and must not be ignored)
reference/*/
!reference/specifications/

# cargo-fuzz working state. A minimized seed corpus is worth committing (see
# the test-estate plan, phase 3.3); these are not -- `target/` is build output,
# `artifacts/` holds raw crash reproducers whose permanent home is a unit test
# in the module that owns the bug, and `coverage/` is regenerated.
fuzz/target/
fuzz/artifacts/
fuzz/coverage/
# NOT committed yet, deliberately: phase 3.3 of the test-estate plan calls for a
# seed corpus minimized from our own fixture .text sections and sample headers.
# What a short smoke run leaves behind is two random inputs, which would look
# like a corpus without being one.
fuzz/corpus/

# The canary objects are the ONE exception to the `*.so` rule above. They are
# committed on purpose: the default test suite decompiles them, and on a fresh
# checkout `tests/decompiler_fixtures/build/` does not exist. Without this
# negation `git add` skips them SILENTLY -- which is how they were first
# committed as a manifest and two test files describing nine binaries that were
# not there.
!tests/decompiler_fixtures/canary/*.so
